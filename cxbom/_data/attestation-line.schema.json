{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cxbom.org/contracts/proxy/2.0.0/attestation-line.schema.json",
  "title": "cxbom attestation line (C3 2.0.0)",
  "description": "One line of a proxy session's write-ahead attestation log. Owner: ATACE Working Group.",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}(?!\\n)$"},
    "time": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z(?!\\n)$"},
    "seqat": {"required": ["seq", "at"], "properties": {"seq": {"type": "integer", "minimum": 1}, "at": {"$ref": "#/$defs/time"}}},
    "storeRef": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "verdict": {"enum": ["pinned-match", "unpinned", "unpinned-version", "changed", "uncanonicalizable",
                         "duplicate-name", "not-approved", "accept-flag-not-allowed"]}
  },
  "type": "object",
  "required": ["kind"],
  "oneOf": [
    {"properties": {"kind": {"const": "session"},
                    "contract": {"type": "object",
                                 "properties": {"name": {"const": "cxbom-attestation"}, "version": {"const": "2.0.0"}},
                                 "required": ["name", "version"], "additionalProperties": false},
                    "proxySessionId": {"type": "string", "format": "uuid"},
                    "serverId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}(?!\\n)$"},
                    "mode": {"enum": ["enforce", "observe"]}, "startedAt": {"$ref": "#/$defs/time"},
                    "pid": {"type": "integer"}, "envelopeSha256": {"$ref": "#/$defs/sha256"},
                    "keyFingerprint": {"$ref": "#/$defs/sha256"}, "launchSha256": {"$ref": "#/$defs/sha256"}},
     "required": ["kind", "contract", "proxySessionId", "serverId", "mode", "startedAt", "pid",
                  "envelopeSha256", "keyFingerprint", "launchSha256"], "additionalProperties": false},
    {"allOf": [{"$ref": "#/$defs/seqat"}],
     "properties": {"kind": {"const": "protocol"}, "seq": true, "at": true, "era": {"enum": ["legacy", "modern"]},
                    "protocolVersion": {"type": "string"}},
     "required": ["kind", "era", "protocolVersion"], "additionalProperties": false},
    {"allOf": [{"$ref": "#/$defs/seqat"}],
     "properties": {"kind": {"const": "server"}, "seq": true, "at": true, "instructionsSha256": {"$ref": "#/$defs/sha256"},
                    "serverInfo": {"type": "object"}, "verdict": {"$ref": "#/$defs/verdict"},
                    "storeRef": {"$ref": "#/$defs/storeRef"}},
     "required": ["kind", "instructionsSha256", "serverInfo", "verdict", "storeRef"], "additionalProperties": false},
    {"allOf": [{"$ref": "#/$defs/seqat"},
               {"if": {"properties": {"verdict": {"const": "uncanonicalizable"}}, "required": ["verdict"]},
                "then": {"properties": {"sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}}},
                "else": {"properties": {"sha256": {"$ref": "#/$defs/sha256"}}}}],
     "properties": {"kind": {"const": "verdict"}, "seq": true, "at": true,
                    "itemType": {"enum": ["tool", "prompt", "resource", "resourceTemplate"]},
                    "name": {"type": "string"}, "sha256": true, "verdict": {"$ref": "#/$defs/verdict"},
                    "approvedBy": {"type": ["string", "null"]}, "approvedAt": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/time"}]},
                    "approvalMode": {"enum": ["interactive", "accept-flag", "rebind", null]},
                    "storeRef": {"$ref": "#/$defs/storeRef"}},
     "required": ["kind", "itemType", "name", "sha256", "verdict", "approvedBy", "approvedAt", "approvalMode", "storeRef"],
     "additionalProperties": false},
    {"allOf": [{"$ref": "#/$defs/seqat"}],
     "properties": {"kind": {"const": "state"}, "seq": true, "at": true,
                    "itemType": {"enum": ["tool", "prompt", "resource", "resourceTemplate", "*"]},
                    "name": {"type": "string"}, "state": {"enum": ["not-listed", "blocked", "unverified"]},
                    "cause": {"type": "string"}},
     "required": ["kind", "itemType", "name", "state", "cause"], "additionalProperties": false},
    {"allOf": [{"$ref": "#/$defs/seqat"}],
     "properties": {"kind": {"const": "diagnostic"}, "seq": true, "at": true, "message": {"type": "string", "maxLength": 2000}},
     "required": ["kind", "message"], "additionalProperties": false},
    {"allOf": [{"$ref": "#/$defs/seqat"}],
     "properties": {"kind": {"const": "end"}, "seq": true, "at": true,
                    "reason": {"enum": ["eof", "signal", "child-exit", "internal-error", "attestation-io"]}},
     "required": ["kind", "reason"], "additionalProperties": false}
  ]
}
