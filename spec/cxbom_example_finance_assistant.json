      "remediation": {
        "immediate": [
          "Apply trust-tier-downgrade label (<tool_definition source=\"external-mcp\" trust=\"ring-1\">) to cc-003 before context assembly",
          "Block invocation of any capability declared by cc-003 not on operator permit-list",
          "Verify MCP server operator identity and checksum before next session"
        ],
        "shortTerm": [
          "Pin external MCP server version in deployment configuration",
          "Add External Provider Inc. to operator permit-list with explicit capability scope",
          "Enable mcp-server-integrity-verification control in tool-execution layer"
        ],
        "strategic": [
          "Enforce Ring 1 classification for all external MCP tool definitions as mandatory control",
          "Require signed security audit of MCP server operators before production approval",
          "Implement CxBOM trust-inversion detection in CI/CD pipeline for all agent deployments",
          "Contribute Tool Definition Trust Inversion as a formal sub-category to OWASP LLM Top 10 (LLM03 / LLM06)"
        ]
      },
