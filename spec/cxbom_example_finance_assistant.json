        "immediate": [
          "Treat retrieved text as data and keep the instruction boundary in the prompt"
        ],
        "shortTerm": [
          "Add a retrieved-content injection check before assembly"
        ],
        "strategic": [
          "Record the instruction/data boundary for every retrieved chunk"
        ]
