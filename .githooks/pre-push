#!/bin/sh
# Anonymity guard. Owner: ATACE Working Group.
# Checks every commit being pushed (identity and message) and the full tree at each pushed tip.
root="$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue            # branch deletion, nothing to scan
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes"               # new branch: commits not on any remote yet
  else
    range="$remote_sha..$local_sha"
  fi
  # shellcheck disable=SC2086  # range is intentionally word-split into git arguments
  python3 "$root/scripts/anon_check.py" range $range || status=1
  python3 "$root/scripts/anon_check.py" tree "$local_sha" || status=1
done
exit $status
