{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cxbom.org/contracts/events/1.4.0/event.schema.json",
  "title": "CxBOM demo event (C2 1.4.0)",
  "description": "One line of a *.events.jsonl stream. Owner: ATACE Working Group.",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?!\\n)$"
    },
    "unit": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "seq",
    "t",
    "run",
    "type",
    "data",
    "prev_sha256"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "prev_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "t": {
      "type": "number",
      "minimum": 0
    },
    "run": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}(?!\\n)$"
    },
    "type": {
      "enum": [
        "attention_frame",
        "attestation_appended",
        "beat",
        "component_assembled",
        "cxbom_emitted",
        "exfil_attempt",
        "gate_decision",
        "inbox_received",
        "launch_refused",
        "lock_checked",
        "mcp_message",
        "model_delta",
        "proxy_exited",
        "proxy_stderr",
        "run_finished",
        "run_started",
        "tool_approved",
        "tool_call",
        "tool_listed",
        "tool_swapped"
      ]
    },
    "data": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "attention_frame"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "shots",
              "ring0",
              "ring1",
              "ring2",
              "ladderIndex"
            ],
            "properties": {
              "shots": {
                "type": "integer",
                "minimum": 0
              },
              "ring0": {
                "$ref": "#/$defs/unit"
              },
              "ring1": {
                "$ref": "#/$defs/unit"
              },
              "ring2": {
                "$ref": "#/$defs/unit"
              },
              "ladderIndex": {
                "type": "integer",
                "minimum": 0
              },
              "sink": {
                "type": "object"
              },
              "evidence": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "attestation_appended"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "serverId",
              "kind",
              "seq",
              "sha256",
              "summary"
            ],
            "properties": {
              "serverId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "kind": {
                "enum": [
                  "session",
                  "protocol",
                  "server",
                  "verdict",
                  "state",
                  "diagnostic",
                  "end"
                ]
              },
              "seq": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "summary": {
                "type": "string",
                "maxLength": 200
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "beat"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "caption",
              "minHoldSeconds"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "caption": {
                "type": "string"
              },
              "minHoldSeconds": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "component_assembled"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "componentId",
              "type",
              "ring",
              "tokens",
              "sourceOrigin",
              "position"
            ],
            "properties": {
              "componentId": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "ring": {
                "enum": [
                  0,
                  1,
                  2
                ]
              },
              "tokens": {
                "type": "integer",
                "minimum": 0
              },
              "sourceOrigin": {
                "type": "string"
              },
              "position": {
                "type": "integer",
                "minimum": 0
              },
              "label": {
                "type": "string"
              },
              "serverChecksumVerified": {
                "type": "boolean"
              },
              "sanitizationStatus": {
                "type": "string"
              },
              "assemblyPosition": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "cxbom_emitted"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "recordPath",
              "findingsOpen",
              "inversionDetected"
            ],
            "properties": {
              "recordPath": {
                "type": "string"
              },
              "findingsOpen": {
                "type": "integer",
                "minimum": 0
              },
              "inversionDetected": {
                "type": "boolean"
              },
              "templateOverheadTokens": {
                "type": "integer",
                "minimum": 0
              },
              "contextWindowTokensUsed": {
                "type": "integer",
                "minimum": 0
              },
              "findings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "title",
                    "category",
                    "severity",
                    "status",
                    "cweRef",
                    "owaspRefs",
                    "affectedComponents"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^finding-[0-9]+(?!\\n)$"
                    },
                    "title": {
                      "type": "string"
                    },
                    "category": {
                      "type": "string"
                    },
                    "severity": {
                      "type": "string",
                      "enum": [
                        "critical",
                        "high",
                        "medium",
                        "low"
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "open",
                        "mitigated",
                        "resolved",
                        "accepted"
                      ]
                    },
                    "cweRef": {
                      "type": "string"
                    },
                    "owaspRefs": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^LLM(0[1-9]|10)(?!\\n)$"
                      }
                    },
                    "affectedComponents": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "exfil_attempt"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tool",
              "url",
              "canaryPresent"
            ],
            "properties": {
              "tool": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "canaryPresent": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "gate_decision"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "serverId",
              "tool",
              "decision",
              "reason"
            ],
            "properties": {
              "serverId": {
                "type": "string"
              },
              "tool": {
                "type": "string"
              },
              "decision": {
                "enum": [
                  "allow",
                  "block",
                  "would-block"
                ]
              },
              "reason": {
                "type": "string"
              },
              "findingId": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "inbox_received"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bytes",
              "canaryPresent"
            ],
            "properties": {
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "canaryPresent": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "launch_refused"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "serverId",
              "item",
              "reason",
              "exitCode"
            ],
            "properties": {
              "serverId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "item": {
                "enum": [
                  "argv",
                  "binary",
                  "interpreter",
                  "files",
                  "trees",
                  "env",
                  "entry",
                  "policy"
                ]
              },
              "reason": {
                "type": "string",
                "maxLength": 512
              },
              "exitCode": {
                "const": 2
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "lock_checked"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "serverId",
              "tool",
              "expectedSha256",
              "actualSha256",
              "match"
            ],
            "properties": {
              "serverId": {
                "type": "string"
              },
              "tool": {
                "type": "string"
              },
              "expectedSha256": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/sha256"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "actualSha256": {
                "$ref": "#/$defs/sha256"
              },
              "match": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "mcp_message"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "method",
              "rpcId",
              "summary"
            ],
            "properties": {
              "from": {
                "enum": [
                  "agent",
                  "proxy",
                  "server"
                ]
              },
              "to": {
                "enum": [
                  "agent",
                  "proxy",
                  "server"
                ]
              },
              "method": {
                "type": "string"
              },
              "rpcId": {
                "type": [
                  "integer",
                  "string",
                  "null"
                ]
              },
              "summary": {
                "type": "string",
                "maxLength": 200
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "model_delta"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "proxy_exited"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "serverId",
              "exitCode"
            ],
            "properties": {
              "serverId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "exitCode": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "proxy_stderr"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "serverId",
              "text"
            ],
            "properties": {
              "serverId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "text": {
                "type": "string",
                "maxLength": 200
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run_finished"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "outcome"
            ],
            "properties": {
              "outcome": {
                "enum": [
                  "exfiltrated",
                  "blocked",
                  "no-attack",
                  "aborted"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run_started"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scenario",
              "gate",
              "model",
              "synthetic",
              "demonstration"
            ],
            "properties": {
              "scenario": {
                "enum": [
                  "clean",
                  "rug-pull",
                  "many-shot",
                  "launch-pin",
                  "benign-update",
                  "malicious-at-approval"
                ]
              },
              "gate": {
                "enum": [
                  "off",
                  "observe",
                  "enforce"
                ]
              },
              "model": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "revision"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "revision": {
                    "type": "string"
                  }
                }
              },
              "synthetic": {
                "type": "boolean"
              },
              "demonstration": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tool_approved"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "serverId",
              "tool",
              "sha256"
            ],
            "properties": {
              "serverId": {
                "type": "string"
              },
              "tool": {
                "type": "string"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tool_call"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tool",
              "arguments"
            ],
            "properties": {
              "tool": {
                "type": "string"
              },
              "arguments": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tool_listed"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "serverId",
              "tool",
              "sha256",
              "phase"
            ],
            "properties": {
              "serverId": {
                "type": "string"
              },
              "tool": {
                "type": "string"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "phase": {
                "enum": [
                  "initial",
                  "refresh"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tool_swapped"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "serverId",
              "tool",
              "oldSha256",
              "newSha256",
              "descriptionDiff"
            ],
            "properties": {
              "serverId": {
                "type": "string"
              },
              "tool": {
                "type": "string"
              },
              "oldSha256": {
                "$ref": "#/$defs/sha256"
              },
              "newSha256": {
                "$ref": "#/$defs/sha256"
              },
              "descriptionDiff": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ]
}
