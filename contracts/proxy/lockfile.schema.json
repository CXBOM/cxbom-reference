{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cxbom.org/contracts/proxy/2.0.0/lockfile.schema.json",
  "title": "cxbom.lock (C3 2.0.0)",
  "description": "Signed envelopes of approved MCP servers. Owner: ATACE Working Group.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "canonicalization", "lockScope", "servers"],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}(?!\\n)$"},
    "time": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z(?!\\n)$"},
    "relpath": {"type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+(?!\\n)$"},
    "fileHash": {"type": "object", "additionalProperties": false, "required": ["name", "sha256"],
                 "properties": {"name": {"type": "string", "minLength": 1, "pattern": "^[^/]+(?!\\n)$"},
                                "sha256": {"$ref": "#/$defs/sha256"}}},
    "pin": {"type": "object", "additionalProperties": false,
            "required": ["sha256", "approvedAt", "approvedBy", "approvalMode", "reason"],
            "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "approvedAt": {"$ref": "#/$defs/time"},
                           "approvedBy": {"type": "string", "pattern": "^[A-Za-z0-9 _.-]{1,64}(?!\\n)$"},
                           "approvalMode": {"enum": ["interactive", "accept-flag", "rebind"]},
                           "reason": {"type": "string", "minLength": 1, "maxLength": 500}}},
    "pins": {"type": "object", "additionalProperties": {"$ref": "#/$defs/pin"}},
    "era": {"type": "object", "additionalProperties": false,
            "required": ["negotiatedVersion", "instructionsSha256", "serverInfo", "tools", "prompts",
                         "resources", "resourceTemplates", "ignoreFields"],
            "properties": {
              "negotiatedVersion": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}(?!\\n)$"},
              "instructionsSha256": {"$ref": "#/$defs/sha256"},
              "serverInfo": {"type": "object"},
              "tools": {"$ref": "#/$defs/pins"}, "prompts": {"$ref": "#/$defs/pins"},
              "resources": {"$ref": "#/$defs/pins"}, "resourceTemplates": {"$ref": "#/$defs/pins"},
              "ignoreFields": {"type": "array", "items": {"type": "object", "additionalProperties": false,
                               "required": ["pointer", "reason"],
                               "properties": {"pointer": {"type": "string", "pattern": "^/_meta(/[^/]+)+(?!\\n)$"},
                                              "reason": {"type": "string", "minLength": 1}}}}}},
    "entry": {"type": "object", "additionalProperties": false,
              "required": ["argv", "binary", "interpreter", "files", "trees", "env", "firstParty",
                           "allowObserve", "allowSampling", "allowAcceptFlag", "renderer",
                           "clientCapabilitiesSha256", "eras"],
              "properties": {
                "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                "binary": {"$ref": "#/$defs/fileHash"},
                "interpreter": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/fileHash"}]},
                "files": {"type": "object", "propertyNames": {"$ref": "#/$defs/relpath"},
                          "additionalProperties": {"$ref": "#/$defs/sha256"}},
                "trees": {"type": "object", "propertyNames": {"$ref": "#/$defs/relpath"},
                          "additionalProperties": {"$ref": "#/$defs/sha256"}},
                "env": {"type": "object", "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*(?!\\n)$"},
                        "additionalProperties": {"oneOf": [
                          {"const": "secret"},
                          {"type": "object", "additionalProperties": false, "required": ["sha256"],
                           "properties": {"sha256": {"$ref": "#/$defs/sha256"}}}]}},
                "firstParty": {"type": "boolean"}, "allowObserve": {"type": "boolean"},
                "allowSampling": {"type": "boolean"}, "allowAcceptFlag": {"type": "boolean"},
                "renderer": {"enum": ["jcs", "json-indent2", "wire"]},
                "clientCapabilitiesSha256": {"$ref": "#/$defs/sha256"},
                "eras": {"type": "object", "minProperties": 1,
                         "propertyNames": {"pattern": "^(legacy|\\d{4}-\\d{2}-\\d{2})(?!\\n)$"},
                         "additionalProperties": {"$ref": "#/$defs/era"}}}},
    "envelope": {"type": "object", "additionalProperties": false,
                 "required": ["serverId", "lockScope", "entrySeq", "issuedAt", "notAfter", "entry"],
                 "properties": {
                   "serverId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}(?!\\n)$"},
                   "lockScope": {"type": "string", "pattern": "^[0-9a-f]{32}(?!\\n)$"},
                   "entrySeq": {"type": "integer", "minimum": 1},
                   "issuedAt": {"$ref": "#/$defs/time"},
                   "notAfter": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/time"}]},
                   "entry": {"$ref": "#/$defs/entry"}}}
  },
  "properties": {
    "contract": {"type": "object", "additionalProperties": false, "required": ["name", "version"],
                 "properties": {"name": {"const": "cxbom-lock"},
                                "version": {"type": "string", "pattern": "^2\\.[0-9]+\\.[0-9]+(?!\\n)$"}}},
    "canonicalization": {"const": "RFC 8785 JSON Canonicalization Scheme"},
    "lockScope": {"type": "string", "pattern": "^[0-9a-f]{32}(?!\\n)$"},
    "servers": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}(?!\\n)$"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["envelope", "signature"],
        "properties": {
          "envelope": {"$ref": "#/$defs/envelope"},
          "signature": {"type": "object", "additionalProperties": false, "required": ["alg", "sig"],
                        "properties": {"alg": {"const": "ed25519"},
                                       "sig": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==(?!\\n)$"}}}}}}
  }
}
